{
  "name": "snapcal-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:mobile": "pnpm --filter @snapcal/mobile dev",
    "dev:admin": "pnpm --filter @snapcal/admin dev",
    "dev:api": "pnpm --filter @snapcal/api dev",
    "dev:ai": "pnpm --filter @snapcal/ai-agent dev",
    "dev:bot": "pnpm --filter @snapcal/telegram-bot dev",
    "build": "pnpm --filter @snapcal/database build \u0026\u0026 pnpm --filter @snapcal/shared build \u0026\u0026 pnpm --filter @snapcal/api build \u0026\u0026 pnpm --filter @snapcal/ai-agent build \u0026\u0026 pnpm --filter @snapcal/telegram-bot build \u0026\u0026 pnpm --filter @snapcal/mobile build \u0026\u0026 pnpm --filter @snapcal/admin build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
