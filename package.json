{
  "name": "snapcal-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:mobile": "pnpm --filter @snapcal/mobile dev",
    "dev:admin": "pnpm --filter @snapcal/admin dev",
    "dev:api": "pnpm --filter @snapcal/api dev",
    "dev:ai": "pnpm --filter @snapcal/ai-agent dev",
    "dev:bot": "pnpm --filter @snapcal/telegram-bot dev",
    "build": "pnpm --filter @snapcal/database build && pnpm --filter @snapcal/shared build && pnpm --filter @snapcal/api build && pnpm --filter @snapcal/ai-agent build && pnpm --filter @snapcal/telegram-bot build && pnpm --filter @snapcal/mobile build && pnpm --filter @snapcal/admin build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  }
}
