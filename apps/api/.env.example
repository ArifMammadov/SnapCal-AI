NODE_ENV=development
PORT=4000

# PostgreSQL — primary (write) connection; add `?pgbouncer=true&connection_limit=10` in production
DATABASE_URL=postgresql://snapcal:snapcal@localhost:5432/snapcal
# Optional read replica / PgBouncer read pool
DATABASE_READ_URL=postgresql://snapcal:snapcal@localhost:5432/snapcal
# Direct Postgres URL for Prisma migrations when DATABASE_URL goes through PgBouncer
DATABASE_DIRECT_URL=postgresql://snapcal:snapcal@localhost:5432/snapcal

# Redis — local or managed Redis
REDIS_URL=redis://localhost:6379

# JWT secrets — MUST be >= 32 random chars in production. Load from Vault.
JWT_SECRET=change_this_to_a_random_string_of_at_least_32_characters
JWT_REFRESH_SECRET=change_this_to_another_random_string_of_at_least_32_characters

# Telegram Bot Token — get from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# LLM provider — OpenRouter recommended for production; Ollama optional fallback
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434

# Stripe — never commit real keys; use Stripe Checkout (no card storage)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Internal app URLs
MOBILE_APP_URL=http://localhost:5173
ADMIN_APP_URL=http://localhost:5176
AI_AGENT_URL=http://localhost:4001
AI_AGENT_SECRET=change_me_at_least_16_chars_for_production

# Object storage — R2/S3/DigitalOcean Spaces
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Admin UI basic guard
ADMIN_SECRET=change_me_at_least_16_chars_for_production
