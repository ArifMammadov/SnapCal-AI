NODE_ENV=development
PORT=4001

# Shared infrastructure
DATABASE_URL=postgresql://snapcal:snapcal@localhost:5432/snapcal
DATABASE_READ_URL=postgresql://snapcal:snapcal@localhost:5432/snapcal
REDIS_URL=redis://localhost:6379

# JWT — same secret as API to validate tokens
JWT_SECRET=change_this_to_a_random_string_of_at_least_32_characters
JWT_REFRESH_SECRET=change_this_to_another_random_string_of_at_least_32_characters

# Telegram — used for mini-app deep links
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_MINI_APP_URL=https://snapcal.health

# LLM providers
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434

# Service-to-service auth (API ↔ AI Agent)
AGENT_SECRET=change_me_at_least_16_chars_for_production
API_SERVICE_URL=http://localhost:4000

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Worker-only mode: set WORKER_ONLY=true to run only the BullMQ vision worker
WORKER_ONLY=false
