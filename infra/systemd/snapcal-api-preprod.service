[Unit]
Description=SnapCal API - Preprod
After=network.target redis-server.service

[Service]
Type=simple
WorkingDirectory=/opt/snapcal-preprod/apps/api
ExecStart=/usr/bin/pnpm start
Restart=always
RestartSec=3
Environment=NODE_ENV=production
Environment=PORT=4004
Environment=HOST=0.0.0.0
EnvironmentFile=/opt/snapcal-preprod/.env

[Install]
WantedBy=default.target
