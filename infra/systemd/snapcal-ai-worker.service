[Unit]
Description=SnapCal AI Vision Queue Worker - Main Production
After=network.target redis-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/snapcal-main/apps/ai-agent
Environment=NODE_ENV=production
EnvironmentFile=/opt/snapcal-main/.env
ExecStart=/usr/bin/pnpm start:worker
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
