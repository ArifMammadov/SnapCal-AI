[Unit]
Description=SnapCal AI Vision Queue Worker
After=network.target redis.service

[Service]
Type=simple
User=snapcal
WorkingDirectory=/opt/snapcal/ai-agent
Environment=NODE_ENV=production
EnvironmentFile=/opt/snapcal/ai-agent/.env
ExecStart=/usr/bin/node dist/worker.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
