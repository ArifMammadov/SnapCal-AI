[Unit]
Description=SnapCal AI Agent - Test
After=network.target redis-server.service

[Service]
Type=simple
WorkingDirectory=/opt/snapcal-main/apps/ai-agent
ExecStart=/usr/bin/pnpm start
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=4005
EnvironmentFile=/opt/snapcal-test/.env

[Install]
WantedBy=default.target
