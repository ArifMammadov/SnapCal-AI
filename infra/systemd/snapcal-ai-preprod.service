[Unit]
Description=SnapCal AI Agent - Preprod Environment
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/snapcal-preprod/apps/ai-agent
ExecStart=/usr/bin/pnpm start
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=4005
Environment=HOST=0.0.0.0

[Install]
WantedBy=default.target
