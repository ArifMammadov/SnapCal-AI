{
  "dashboard": {
    "id": null,
    "title": "SnapCal AI Agent",
    "tags": ["snapcal", "ai-agent"],
    "timezone": "utc",
    "schemaVersion": 36,
    "refresh": "15s",
    "panels": [
      {
        "id": 1,
        "title": "AI Requests / sec",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(snapcal_ai_requests_total[5m])",
            "legendFormat": "{{skill}} - {{status}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
      },
      {
        "id": 2,
        "title": "p95 Latency",
        "type": "timeseries",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(snapcal_ai_latency_seconds_bucket[5m]))",
            "legendFormat": "{{skill}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
      },
      {
        "id": 3,
        "title": "Error Rate / sec",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(snapcal_ai_errors_total[5m])",
            "legendFormat": "{{skill}} - {{error_type}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
      },
      {
        "id": 4,
        "title": "Estimated Cost (USD/hour)",
        "type": "stat",
        "targets": [
          {
            "expr": "increase(snapcal_ai_cost_usd_total[1h])",
            "legendFormat": "{{model}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
      },
      {
        "id": 5,
        "title": "Vision Queue Jobs",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(snapcal_ai_vision_queue_jobs_total[5m])",
            "legendFormat": "{{state}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 }
      },
      {
        "id": 6,
        "title": "Top Models by Cost",
        "type": "piechart",
        "targets": [
          {
            "expr": "topk(5, increase(snapcal_ai_cost_usd_total[1h]))",
            "legendFormat": "{{model}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 }
      }
    ]
  }
}
